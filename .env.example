# Copy to .env (git-ignored) and fill in. The app reads .env on startup (spring.config.import in
# application.yml), so the GATEWAY_* and WEBHOOK_* values configure it from the IDE or the terminal
# alike. The ITAU_* and CIELO_* values are not read by the app: they are what you send to
# PUT /v1/admin/merchants/{id}/providers/.../credentials for a merchant.
#
# Properties format: no quotes, and comments only on their own line. An inline comment becomes
# part of the value.

# --- app ---
GATEWAY_ADMIN_KEY=
GATEWAY_API_KEY_PEPPER=
# keys the idempotency body hash (bodies carry PAN + CVV); empty = the pepper
GATEWAY_IDEMPOTENCY_HMAC_KEY=
# base64 of 32 random bytes: openssl rand -base64 32
GATEWAY_MASTER_KEY=

# --- Itaú sandbox (portal "criar credenciais"); TEST environment, no certificate ---
ITAU_SANDBOX_CLIENT_ID=
ITAU_SANDBOX_CLIENT_SECRET=
# the receiving Pix key the sandbox accepts, e.g. the CNPJ used in the docs examples
ITAU_SANDBOX_PIX_KEY=
# Bolecode: agencia (4) + conta (7) + DAC (1); the docs' example is 150000052061
ITAU_SANDBOX_BENEFICIARY_ID=
# Bolecode carteira; 109 is the one the product documents
ITAU_SANDBOX_WALLET_CODE=109
# Bolecode especie; 01 = DM (duplicata mercantil)
ITAU_SANDBOX_SPECIES_CODE=01

# --- Itaú production (dynamic certificate flow); LIVE environment ---
ITAU_LIVE_CLIENT_ID=
ITAU_LIVE_CLIENT_SECRET=
# x-itau-apikey (uuid)
ITAU_LIVE_APIKEY=
ITAU_LIVE_CERT_PEM_PATH=
ITAU_LIVE_KEY_PEM_PATH=
ITAU_LIVE_PIX_KEY=
# Bolecode: the account's agencia+conta+DAC, 12 digits
ITAU_LIVE_BENEFICIARY_ID=
ITAU_LIVE_WALLET_CODE=109
ITAU_LIVE_SPECIES_CODE=01
# CA chain from the portal's ca-cert.zip (used by the app as gateway.providers.itau.trust-store-pem)
ITAU_CA_PEM=

# --- Cielo sandbox (form at docs.cielo.com.br/ecommerce-cielo/page/sandbox-api-ecommerce, no contract); TEST environment ---
# Sent to PUT /v1/admin/merchants/{id}/providers/CIELO/credentials as {"merchant_id", "merchant_key"}.
# a GUID
CIELO_SANDBOX_MERCHANT_ID=
# 40 letters or digits
CIELO_SANDBOX_MERCHANT_KEY=
# the fixed header value set at the Cielo and at PUT …/providers/CIELO/notification-key
CIELO_NOTIFICATION_KEY=

# --- inbound bank webhook (mTLS connector; app reads these as gateway.webhooks.mtls.*) ---
# 0 disables the connector
WEBHOOK_MTLS_PORT=8443
# PKCS12 with the server certificate for the public webhook host
WEBHOOK_MTLS_KEYSTORE=
WEBHOOK_MTLS_KEYSTORE_PASSWORD=
# PKCS12 with the bank's CA (ca-cert.zip)
WEBHOOK_MTLS_TRUSTSTORE=
WEBHOOK_MTLS_TRUSTSTORE_PASSWORD=
WEBHOOK_MTLS_PUBLIC_HOST=
# Exact client-certificate subject DNs allowed to post webhooks (comma-separated). Empty = any
# certificate the trusted CA signed. Unverified whether the bank's CA also signs other customers'
# certificates: find out the bank's webhook certificate subject and set this BEFORE go-live.
WEBHOOK_MTLS_ALLOWED_SUBJECTS=

# Where the payer-facing front serves /pay/ (the checkout token is appended). Default: local dev front.
GATEWAY_CHECKOUT_BASE_URL=
# Exact browser origins allowed to call the API (comma-separated). Empty = CORS off.
GATEWAY_CORS_ORIGINS=

# --- panel e-mail (SMTP); empty host = e-mails are logged, not sent ---
GATEWAY_MAIL_HOST=
GATEWAY_MAIL_PORT=587
# empty = no auth and no STARTTLS (a local relay)
GATEWAY_MAIL_USERNAME=
GATEWAY_MAIL_PASSWORD=
GATEWAY_MAIL_FROM=
# Where the merchant panel is served; e-mail links (verify, reset, invite) start here.
GATEWAY_PANEL_BASE_URL=
# Outside the local and test profiles an empty GATEWAY_MAIL_HOST or a localhost
# GATEWAY_PANEL_BASE_URL fails startup. Keep this line on a dev box, drop it in production.
spring.profiles.active=local

# --- panel sign-in ---
# Argon2 hashes running at once (64 MB each); past it, 503 AUTH_BUSY. Default 8.
GATEWAY_AUTH_MAX_CONCURRENT_HASHES=8
